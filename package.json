{
  "name": "codex-deck-m18",
  "version": "0.7.0-hotfix.2",
  "private": true,
  "type": "module",
  "description": "Unofficial Codex Micro bridge for Stream Deck on Windows and macOS, with optional multi-host relay",
  "license": "MIT",
  "author": "omusubiman5",
  "repository": {
    "type": "git",
    "url": "https://github.com/omusubiman5/codex-deck-m18.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-launcher.mjs",
    "build:vsd-craft": "npm run build && node scripts/build-vsd-craft.mjs",
    "build:m18": "cargo build --release --manifest-path m18-adapter/Cargo.toml && node scripts/build-m18.mjs",
    "start:m18": "node dist/m18/codex-deck-m18.mjs",
    "docs:preview": "tsx scripts/generate-doc-preview.ts",
    "qa:local-icons": "tsx scripts/generate-local-icon-qa.ts",
    "smoke:relay": "tsx scripts/relay-smoke.ts",
    "audit:release": "node scripts/audit-release.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "npm run build && streamdeck validate dist/com.simeo.codex-deck.sdPlugin",
    "validate:vsd-craft": "npm run build:vsd-craft && node scripts/validate-vsd-craft.mjs",
    "configure:meeting-panels": "node scripts/configure-vsd-craft-meeting-panels.mjs",
    "install:vsd-craft:macos": "zsh scripts/install-vsd-craft-codex-deck-macos.sh",
    "pack": "npm run build && streamdeck pack dist/com.simeo.codex-deck.sdPlugin --force",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0",
    "bonjour-service": "^1.4.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "sharp": "^0.35.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
